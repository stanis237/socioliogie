# Fichier de configuration des variables d'environnement
# Copiez ce fichier en .env et remplissez vos valeurs réelles
# Ne jamais committer le fichier .env dans votre dépôt Git !

# Clé API Google Gemini (obtenez-la sur https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Clé secrète Django (remplacez en production)
# DJANGO_SECRET_KEY=votre-cle-secrete-ici

# Mode Debug (True en développement, False en production)
# DJANGO_DEBUG=True
